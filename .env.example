# Copy to .env and fill in real values. Never commit .env.

# --- Market & universe ---
MARKET=INDIA
EXCHANGE=NSE
MIN_PRICE=50
MAX_PRICE=300
MIN_AVG_TRADED_VALUE=5000000
EXCLUDE_SME=true
MIN_HISTORY_DAYS=250

# --- Database & storage ---
# SQLite is fine for local testing (scripts/run_local_test.py uses this by default).
# Switch to a real Postgres URL only for production/Azure deployment.
DATABASE_URL=sqlite:///./databroker.db
ANALYTICAL_STORAGE_URI=

# --- Market data provider ---
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_WS_URL=

# --- Temporary testing setup (docs/PROJECT_PLAN.md) — free, keyless-or-cheap sources
# used before a broker account is wired in. See scripts/run_local_test.py.
INDIANAPI_API_KEY=
WATCHLIST_SYMBOLS=TCS,RELIANCE,INFY

# --- News / company data providers ---
NEWS_PROVIDER=
NEWS_API_KEY=
COMPANY_DATA_PROVIDER=

# --- LLM providers (comma-separated keys enable failover, not rate-limit bypass) ---
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
LLM_DEFAULT_ROUTING_PROFILE=cost_aware

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerts ---
ALERT_COOLDOWN_SECONDS=900
# How often the anomaly model retrains itself. Cheap (local compute, no LLM), so
# daily is fine even on a small VM. Set 0 to disable auto-retrain.
RETRAIN_INTERVAL_DAYS=1
# How often scripts/run_service.py checks the watchlist while NSE is open (seconds).
POLL_INTERVAL_SECONDS=300

# --- Deployment ---
DEPLOY_ENV=local
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
